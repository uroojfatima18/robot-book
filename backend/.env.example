# ============================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================

# Database (Neon PostgreSQL)
# Get connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-4.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Better Auth (Authentication Service)
# Generate secret: https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3001

# Vector Database (Qdrant Cloud)
# Get from: https://cloud.qdrant.io/
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# LLM APIs (at least one required)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Email Service (Resend)
# Get keys from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# OPTIONAL ENVIRONMENT VARIABLES
# ============================================

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Book documentation path (relative to backend directory)
DOCS_PATH=../my-website/docs

# Qdrant collection name
COLLECTION_NAME=book_chunks

# Embedding model (defaults to openai/text-embedding-3-small)
EMBEDDING_MODEL=openai/text-embedding-3-small

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 
# LOCAL DEVELOPMENT:
# - Copy this file to .env
# - Fill in with your actual credentials
# - Never commit .env to git
#
# HUGGING FACE SPACES:
# - Add each variable as a Repository Secret
# - Go to: Space Settings → Repository Secrets
# - Do NOT use .env files in production
#
# SECURITY:
# - Keep all API keys private
# - Rotate keys regularly
# - Use minimal required permissions
# - Never share .env file contents
