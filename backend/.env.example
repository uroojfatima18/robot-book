# OpenRouter API Key (get from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Embedding model via OpenRouter (defaults to openai/text-embedding-3-small)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Qdrant Vector Database
QDRANT_URL=https://your-qdrant-url.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Neon PostgreSQL (for storing metadata, user data, etc.)
DATABASE_URL=postgresql://user:password@host/database

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Book documentation path (relative to backend directory)
DOCS_PATH=../my-website/docs

# Qdrant collection name
COLLECTION_NAME=book_chunks
